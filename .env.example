# TROIT Logistics — Frontend Environment Variables Example
# IMPORTANT: Frontend environment variables are exposed in client builds.
# NEVER place private keys, API secrets, database credentials, or payment/escrow secrets here.

# Development API URL:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production API URL (Configure in Vercel Project Environment Variables):
# VITE_API_BASE_URL=https://troit-logistics-backend.onrender.com/api/v1

VITE_APP_NAME=TROIT Logistics

